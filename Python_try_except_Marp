# 🎨 第四阶段：项目实战

## 学生成绩管理系统（异常处理版）

功能：安全地输入和计算学生平均分

---

## 获取学生成绩函数

```python
def get_student_scores():
    """获取学生成绩"""
    scores = []
    print("请输入学生成绩（输入-1结束）：")

    while True:
        try:
            score = input(f"成绩{len(scores)+1}: ")

            if score == "-1":
                if len(scores) == 0:
                    print("至少输入一个成绩！")
                    continue
                break

            score = float(score)

            if score < 0 or score > 100:
                raise ValueError("成绩应该在0-100之间")

            scores.append(score)

        except ValueError as e:
            print(f"输入无效: {e}")
            print("请重新输入...")

    return scores
```

---

## 计算平均分函数

```python
def calculate_average(scores):
    """计算平均分"""
    try:
        if len(scores) == 0:
            raise ValueError("成绩列表为空")

        total = sum(scores)
        average = total / len(scores)
        return average

    except ZeroDivisionError:
        return 0
    except Exception as e:
        print(f"计算出错: {e}")
        return None
```

---

## 保存到文件函数

```python
def save_to_file(filename, scores, average):
    """将结果保存到文件"""
    try:
        with open(filename, "w", encoding="utf-8") as file:
            file.write("=== 学生成绩报告 ===\n")
            file.write(f"成绩数量: {len(scores)}\n")
            file.write("所有成绩: " + ", ".join(map(str, scores)) + "\n")
            file.write(f"平均分: {average:.2f}\n")

        print(f"结果已保存到 {filename}")

    except PermissionError:
        print("错误：没有写入权限，请检查文件是否被占用")
    except Exception as e:
        print(f"保存文件时出错: {e}")
```

---

## 主程序

```python
def main():
    """主程序"""
    print("=" * 40)
    print("学生成绩管理系统")
    print("=" * 40)

    try:
        # 1. 获取成绩
        scores = get_student_scores()

        # 2. 计算平均分
        average = calculate_average(scores)

        if average is not None:
            print(f"\n统计结果：")
            print(f"输入了 {len(scores)} 个成绩")
            print(f"平均分: {average:.2f}")

            # 3. 保存结果
            save_to_file("成绩报告.txt", scores, average)

    except KeyboardInterrupt:
        print("\n\n程序被用户中断")
    except Exception as e:
        print(f"程序运行出错: {e}")
    finally:
        print("\n感谢使用学生成绩管理系统！")

# 运行程序
if __name__ == "__main__":
    main()
```

